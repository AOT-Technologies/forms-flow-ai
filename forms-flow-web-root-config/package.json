    "eslint-plugin-prettier": "^3.4.1",
    "jest-cli": "^30.5.2",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "serve": "^14.2.4",
    "webpack-dev-server": "^5.2.7"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "@types/systemjs": "^6.15.4",
    "dotenv": "^18.0.7",
